# Keep the npm cache inside the project workspace.
#
# Why this file exists: the DSH file sandbox only permits writes under the
# session workspace, so the default user-level cache (%LOCALAPPDATA%\npm-cache)
# makes npm fail with EPERM mid-install.
#
# NOTE: a `cache=` line here is NOT sufficient, because the agent harness
# exports `npm_config_cache` as an environment variable, and npm gives
# environment variables higher precedence than project .npmrc files. The
# scripts below therefore pass `--cache` explicitly on the command line, which
# has the highest precedence. Do not remove those flags.
#
# Keep the value absolute and quoted: the workspace path contains a space.
cache=C:\Users\Lidaz\Desktop\VibeCoding Projects\.npm-cache

fund=false
audit=false
