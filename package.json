{
  "name": "cashinflow",
  "version": "1.7.1",
  "description": "CashInflow — a local-first multi-currency personal finance manager for Windows. Electron + React + SQLite.",
  "main": "./out/main/index.js",
  "author": "CashInflow",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:parse": "node tools/check-parse.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-builder install-app-deps",
    "build": "npm run check:parse && npm run typecheck && electron-vite build",
    "build:app": "electron-vite build",
    "dist": "npm run rebuild && npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run rebuild && npm run build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "date-fns": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
