# Dependencies
node_modules/

# Build output
out/
dist/
release/
*.tsbuildinfo

# Local npm cache (kept inside the workspace by .npmrc)
.npm-cache/

# Screenshot harness.
#
# Used to regenerate docs/images/*.png from a running app. Kept out of the
# repository because it is a one-off maintenance tool, not part of the product or
# its build.
tools/

# Ad-hoc verification artefacts
shot-*.png
probe-*.cjs

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local databases — a user's financial data must never be committed.
# The real database lives in %APPDATA%\CashInflow; a stray copy here (from a test
# or a manual experiment) would be a serious leak.
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.local
