# Dependencies
node_modules/

# Build output
out/
dist/
release/
*.tsbuildinfo

# Local npm cache (kept inside the workspace by .npmrc)
.npm-cache/

# Screenshot and documentation tooling.
#
# Ignored by default because most of what lands here is one-off scratch work
# (ad-hoc CDP setup snippets, verification probes). The four scripts the README
# tells a reader to run are un-ignored below, so "the screenshots are
# reproducible" is a claim the repository can actually back up.
tools/
!tools/shots.cjs
!tools/shot.cjs
!tools/make-diagram.ps1
!tools/bom-ps1.cjs

# Ad-hoc verification artefacts
shot-*.png
probe-*.cjs

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local databases — a user's financial data must never be committed.
# The real database lives in %APPDATA%\CashInflow; a stray copy here (from a test
# or a manual experiment) would be a serious leak.
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.local
